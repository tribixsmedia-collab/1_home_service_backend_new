# Copy this file to .env and fill in your real values. Never commit .env.
# This file is committed, so every value here must be a placeholder.
#
# Note: a value runs to the end of the line. A trailing "# comment" becomes
# part of the value, so do not put comments on the same line as a setting.

# --- Core ---
# DEBUG defaults to False. Turn it on only on your own machine.
DEBUG=True

# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Required whenever DEBUG=False. Use a different one on every server.
SECRET_KEY=

# Comma-separated bare hostnames. No brackets, no quotes, no scheme.
# Production example: ALLOWED_HOSTS=api.example.com,example.com
ALLOWED_HOSTS=localhost,127.0.0.1

# India. Only affects how times are read and shown; storage stays UTC.
TIME_ZONE=Asia/Kolkata

# --- Database ---
DB_NAME=homeservice_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Web browser access (does not affect the phone apps) ---
# Which sites may call this API from a browser. Needs the scheme.
# CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com
CORS_ALLOWED_ORIGINS=

# Leave unset in production. Defaults to the value of DEBUG.
# CORS_ALLOW_ALL_ORIGINS=False

# Required for the admin dashboard to accept form posts over https.
# CSRF_TRUSTED_ORIGINS=https://api.example.com,https://example.com
CSRF_TRUSTED_ORIGINS=

# --- HTTPS ---
# Both default sensibly from DEBUG; override only if you need to.
# SECURE_SSL_REDIRECT=True
#
# HSTS cannot be withdrawn early -- a browser honours the last value it saw
# for its full duration. Prove https works, then raise this in steps:
# 300 -> 86400 -> 31536000.
SECURE_HSTS_SECONDS=0

# --- OTP / SMS ---
# 'console' = FREE, prints the OTP to your terminal, for development only.
# 'fast2sms' / 'msg91' / 'twilio' = real SMS, needs the matching key below.
SMS_BACKEND=console
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60

FAST2SMS_API_KEY=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Email (OTP delivery) ---
# EMAIL_BACKEND follows DEBUG automatically: printed to the terminal while
# developing, sent over SMTP in production. Override only to force one.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# --- Firebase Cloud Messaging (push notifications) ---
# The service-account JSON is a private key: it is gitignored and must be
# copied to each server by hand. Blank project id = push switched off.
FCM_ENABLED=True
FCM_PROJECT_ID=
# FCM_CREDENTIALS_FILE=/srv/home_service/secrets/fcm-service-account.json

# --- Razorpay ---
# Dashboard -> Settings -> API Keys. Only rzp_live_* keys move real money.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR

# --- RazorpayX (payouts) ---
# Blank RAZORPAYX_ACCOUNT_NUMBER = payouts disabled.
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=
RAZORPAYX_PAYOUT_MODE=IMPS
RAZORPAYX_VALIDATE_ACCOUNTS=True

# --- Cloudinary (image & video CDN) ---
# CLOUD_NAME is the "Cloud name" at the top of the Cloudinary console, not
# your login. Leave it blank to store media on local disk instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Vendor ID documents ---
# These never go to Cloudinary (config/storages.py explains why) and are served
# by a permission-checked view, not by a plain media URL.
#
# On nginx, switching this on lets nginx stream the file while Python only
# writes a header -- it needs the `internal` /protected-media/ block from
# deploy/nginx.conf to exist. Off, Django reads the file itself: slower, and
# equally private. Off is the safe default, so leave it alone unless deploying.
# MEDIA_X_ACCEL_REDIRECT=False
# MEDIA_X_ACCEL_PREFIX=/protected-media/

# --- Public legal pages (/privacy/, /terms/, /data-deletion/) ---
# Google Play checks the privacy policy URL before accepting a listing, and its
# account-deletion policy requires a public page anyone can reach without the
# app. While any of the three below is blank the pages render a visible "not
# finished" banner, so an unfinished policy cannot be submitted by mistake.
LEGAL_COMPANY_NAME=RNI Services
LEGAL_CONTACT_EMAIL=
LEGAL_CONTACT_PHONE=
LEGAL_ADDRESS=
LEGAL_LAST_UPDATED=
