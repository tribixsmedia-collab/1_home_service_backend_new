# Production .env for the EC2 box. Copy to /srv/homeservice/.env and fill in.
#
#   sudo -u www-data cp deploy/env.production.example /srv/homeservice/.env
#   sudo -u www-data nano /srv/homeservice/.env
#   sudo chmod 600 /srv/homeservice/.env
#
# This file is a template and holds no secrets. The real .env must never be
# committed -- .gitignore already excludes it.
#
# Every key an integration needs is listed in .env.example with fuller notes.
# What follows is only the ones whose *production* value differs, plus the AWS
# specifics.


# ---------- Core ----------

DEBUG=False

# Generate once, on the server, and never reuse the development one:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# The domains this server answers to. No scheme, no trailing slash.
ALLOWED_HOSTS=api.yourdomain.com

# Where the browser-based admin dashboard is reached from. Needed because the
# dashboard posts forms; without it every save fails CSRF.
CSRF_TRUSTED_ORIGINS=https://api.yourdomain.com

# The website build of the customer app, if it is served from another domain.
# Leave blank if the apps are phone-only -- the mobile apps do not need CORS.
CORS_ALLOWED_ORIGINS=https://www.yourdomain.com

# Turn on only once HTTPS is confirmed working. It tells browsers to refuse
# plain http to this domain for the given number of seconds, and they will
# remember it -- so a wrong certificate becomes a site nobody can reach.
# Start at 0. After a week of clean HTTPS, set 31536000 (one year).
SECURE_HSTS_SECONDS=0


# ---------- Database: AWS RDS for PostgreSQL ----------
#
# Create the instance in ap-south-1 (Mumbai), same VPC as the EC2 box, and
# leave "Public access" set to No. Give it a security group that allows port
# 5432 *only* from the EC2 instance's security group -- not from 0.0.0.0/0.
#
# DB_HOST is the RDS endpoint, without the port:
#   homeservice.abcdefghij.ap-south-1.rds.amazonaws.com

DB_NAME=homeservice_db
DB_USER=homeservice
DB_PASSWORD=
DB_HOST=
DB_PORT=5432


# ---------- Vendor ID documents ----------
#
# Hands the file to nginx instead of streaming it through Python, once the
# /protected-media/ block from deploy/nginx.conf is in place. The permission
# check happens either way -- this only changes who moves the bytes.
MEDIA_X_ACCEL_REDIRECT=True
MEDIA_X_ACCEL_PREFIX=/protected-media/


# ---------- Email: AWS SES ----------
#
# SES starts in "sandbox" mode and will only deliver to addresses you have
# verified. Login codes go to real customers, so raise the production-access
# request early -- it takes about a day.
#
# EMAIL_HOST_USER / PASSWORD are SES *SMTP credentials*, which you generate in
# the SES console. They are not your AWS access key.
#
# Verify the sending domain in SES and add its DKIM records, or mail lands in
# spam.

EMAIL_HOST=email-smtp.ap-south-1.amazonaws.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@yourdomain.com


# ---------- SMS ----------
#
# Not AWS. SNS charges far more for Indian numbers and still needs the same DLT
# registration, so Fast2SMS or MSG91 stays the right choice.
# Switch from console to the provider only once DLT approval has come through.

SMS_BACKEND=console
FAST2SMS_API_KEY=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=


# ---------- Razorpay ----------
#
# Live keys, not test keys. The webhook secret is the string you typed when
# adding the webhook in the Razorpay dashboard, pointing at:
#   https://api.yourdomain.com/api/payments/webhook/razorpay/

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR


# ---------- RazorpayX payouts (optional) ----------
#
# Leave blank to keep paying vendors by hand, which is the safer way to start.
# Blank means the dashboard shows the manual reference-number field instead.

RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=
RAZORPAYX_PAYOUT_MODE=IMPS
RAZORPAYX_VALIDATE_ACCOUNTS=True


# ---------- Push notifications: Firebase ----------
#
# Download the service-account JSON from Firebase console > Project settings >
# Service accounts, and put it at /srv/homeservice/secrets/fcm-service-account.json
#   sudo chown www-data:www-data /srv/homeservice/secrets/fcm-service-account.json
#   sudo chmod 600 /srv/homeservice/secrets/fcm-service-account.json
#
# Set FCM_ENABLED=False to run without push; notifications are still recorded
# in-app, they just do not reach the phone.

FCM_ENABLED=True
FCM_PROJECT_ID=rni-home-services
FCM_CREDENTIALS_FILE=/srv/homeservice/secrets/fcm-service-account.json


# ---------- Cloudinary ----------
#
# Staying on Cloudinary rather than S3: it resizes and re-encodes images on
# delivery, which S3 alone does not. Vendor ID documents deliberately never go
# here -- they stay on this server's disk. See config/storages.py.

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# ---------- Timezone ----------

TIME_ZONE=Asia/Kolkata


# ---------- Public legal pages ----------
#
# https://api.yourdomain.com/privacy/ is the URL Google Play asks for, and
# /data-deletion/ is the one its account-deletion policy requires. Both must be
# reachable signed out; they are.
#
# Leave any of these blank and the pages show a "not finished" banner rather
# than quietly publishing a policy with gaps in it.

LEGAL_COMPANY_NAME=RNI Services
LEGAL_CONTACT_EMAIL=
LEGAL_CONTACT_PHONE=
LEGAL_ADDRESS=
LEGAL_LAST_UPDATED=
